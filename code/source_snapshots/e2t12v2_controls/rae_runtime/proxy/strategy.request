# ----- Strategy definition (atrade engine .request) -----------------------
# This is the versioned strategy the agentic loop tunes and commits. Each KEY =
# value is an engine parameter: factor rules/weights (VALUE_*, GROWTH_*), the
# screener, conviction combiner, portfolio caps, stop-losses and the backtest
# window. The rule *maths* lives in the atrade engine pinned by atrade_sifting_*;
# this file selects and weights which rules fire. Edit parameters here to change
# the strategy — do not add non-engine keys.
purpose          = backtest
SIGNALGENERATION = false

# ----- Jenkins properties - typical branch or tag names e.g.: 2.10.0-RELEASE, master, develop
atrade_sifting_commons   = 2.10.0-RELEASE
atrade_sifting_pretrade  = 2.10.0-RELEASE
atrade_sifting_portfolio = 2.10.0-RELEASE
atrade_sifting_hedge     = 2.10.0-RELEASE
atrade_sifting_model     = 2.10.0-RELEASE
atrade_sifting_config    = 2.10.0-RELEASE

# ----- Cluster properties
# Intentional dataset refresh from the 2.10.0 legacy baseline; not factor-specific.
runner_dracusURL = http://amok.cs.ucl.ac.uk:8080/fwt
runner_dataURL   = 2026-06-07_pyspark/2.9.0-RELEASE

# ----- Master-indices properties
runner_longStockDefs   = /opt/simulations-service/conf/master-indices_2026-06-07_2.9.0-RELEASE_pyspark/longStockDefsUS_inPrimaryShareClass.txt
runner_shortStockDefs  = /opt/simulations-service/conf/master-indices_2026-06-07_2.9.0-RELEASE_pyspark/shortStockDefs.txt
runner_shortIndiceDefs = /opt/simulations-service/conf/master-indices_2026-06-07_2.9.0-RELEASE_pyspark/shortIndiceDefs.txt

# ----- Backtest parameters
STARTDATE = 2000-01-17
ENDDATE   = 2025-01-02

NFREQ    = 4
NPORT    = 80
NDELAY   = 208
SLIPPAGE = 0.0075
INITCASH = 250000

# ----- Pre-Screener -----
STOCKSCREENER = true

ACTIVE_HARD_PRESCREENER_RULES  = CHECKMARKETCAP,CHECKPE
ACTIVE_SOFT_PRESCREENER_RULES  = SCOREROOC,SCOREPB,SCOREFCFVSDEBT
ACTIVE_SOFT_PRESCREENER_POINTS = 4,2,1
FUNDAMENTALSTHRESHOLD          = 4
MINCAPITALISATION = 300.0
MINPE   = 3.0
MAXPE   = 40.0
MINGAIN = 0.02
LEEWAY  = 0.0

# ----- Expert Weights -----
VALUE_EXPERTWGHT_Commercial\u0020Services	= 0.01	
VALUE_EXPERTWGHT_Communications			= 0.01	
VALUE_EXPERTWGHT_Consumer\u0020Durables		= 0.01	
VALUE_EXPERTWGHT_Consumer\u0020Non-Durables	= 0.01	
VALUE_EXPERTWGHT_Consumer\u0020Services		= 0.01	
VALUE_EXPERTWGHT_Distribution\u0020Services	= 0.34	
VALUE_EXPERTWGHT_Electronic\u0020Technology	= 0.34	
VALUE_EXPERTWGHT_Energy\u0020Minerals		= 0.34	
VALUE_EXPERTWGHT_Finance			= 0.66	
VALUE_EXPERTWGHT_Health\u0020Services		= 0.66	
VALUE_EXPERTWGHT_Health\u0020Technology		= 0.99	
VALUE_EXPERTWGHT_Industrial\u0020Services	= 0.99	
VALUE_EXPERTWGHT_Miscellaneous			= 0.99	
VALUE_EXPERTWGHT_Non-Energy\u0020Minerals	= 0.99	
VALUE_EXPERTWGHT_Process\u0020Industries	= 0.99	
VALUE_EXPERTWGHT_Producer\u0020Manufacturing	= 0.99	
VALUE_EXPERTWGHT_Retail\u0020Trade		= 0.99	
VALUE_EXPERTWGHT_Technology\u0020Services	= 0.99	
VALUE_EXPERTWGHT_Transportation			= 0.99	
VALUE_EXPERTWGHT_Utilities			= 0.99
# VALUE_EXPERTWGHT_Government			= 0.00

GROWTH_EXPERTWGHT_Commercial\u0020Services	= 0.99	
GROWTH_EXPERTWGHT_Communications		= 0.99	
GROWTH_EXPERTWGHT_Consumer\u0020Durables	= 0.99	
GROWTH_EXPERTWGHT_Consumer\u0020Non-Durables	= 0.99	
GROWTH_EXPERTWGHT_Consumer\u0020Services	= 0.99	
GROWTH_EXPERTWGHT_Distribution\u0020Services	= 0.66	
GROWTH_EXPERTWGHT_Electronic\u0020Technology	= 0.66	
GROWTH_EXPERTWGHT_Energy\u0020Minerals		= 0.66	
GROWTH_EXPERTWGHT_Finance			= 0.34	
GROWTH_EXPERTWGHT_Health\u0020Services		= 0.34	
GROWTH_EXPERTWGHT_Health\u0020Technology	= 0.01	
GROWTH_EXPERTWGHT_Industrial\u0020Services	= 0.01	
GROWTH_EXPERTWGHT_Miscellaneous			= 0.01	
GROWTH_EXPERTWGHT_Non-Energy\u0020Minerals	= 0.01	
GROWTH_EXPERTWGHT_Process\u0020Industries	= 0.01	
GROWTH_EXPERTWGHT_Producer\u0020Manufacturing	= 0.01	
GROWTH_EXPERTWGHT_Retail\u0020Trade		= 0.01	
GROWTH_EXPERTWGHT_Technology\u0020Services	= 0.01	
GROWTH_EXPERTWGHT_Transportation		= 0.01	
GROWTH_EXPERTWGHT_Utilities			= 0.01
#GROWTH_EXPERTWGHT_Government			= 0.00

# ----- Value Factor
VALUE_ACTIVE_RULES=1,2,3,4,5
VALUE_FILTERINGMETHOD=IQR
VALUE_NORMALISATIONMETHOD=SIGMOID
VALUE_DECAYFACTOR=0.4
VALUE_UPDATE=IDENTITY
VALUE_RESET=false

VALUE_MINMARGINOS=-1000.0
VALUE_MAXMARGINOS=1000.0

# ----- Growth Factor
GROWTH_ACTIVE_RULES=1,4
GROWTH_FILTERINGMETHOD=IQR
GROWTH_NORMALISATIONMETHOD=SIGMOID
GROWTH_DECAYFACTOR=0.4
GROWTH_UPDATE=IDENTITY
GROWTH_RESET=false

GROWTH_MINEPS5YGROWTHRATE=0.2
GROWTH_MAXEPS5YGROWTHRATE=0.5
        
# ----- cache ------
EMAWINDOW=5
LTU_WINDOW_SIZE=756

# ----- caps -----
LIQUIDITYCAP=0.2
SHARESCAP=0.05
SECTORCAP=0.175
UCITSCAP=true
STOPLOSSTYPE=STATIC
STATICSTOPLOSS=1.0
PORTFOLIOSTOPLOSS=1

# ---- scoring -----
INVERTED_SCORES=GROWTH
NORMALISATIONMETHOD=SIGMOID
NTOP=10000
TOPSCOREPOINTS=4
TOPSCOREBAND=15
EMAFACTOR=1
MINCONVICTION=0.0
CONVICTIONCOMBINER=UNION_N_EMA_NOSEC_NOAVGTOPN

# ---- allocation -----
MIN_POSITION_WEIGHT=0.002
RATIO_OF_STOCKS_IN_SECTOR=0.15
SIMPLEX_CYCLEMODE=RELAX_CC_UB_LB
SIMPLEX_BOUNDSETTING=BOUNDS_1_4
PORTFOLIOPROPOSAL_UPDATE=SIMPLEX

# ---- logging -----
PORTFOLIO_PROPOSAL_OBSERVER_TYPE=EXTENSIVE
VERBOSE_CONVICTIONCOMBINER=true
FUNDAMENTALS_OBSERVER_TYPE=LAZY
SQLENABLED=true
VERBOSE_CONVICTIONUPDATER=true
PORTFOLIO_OBSERVER_TYPE=EXTENSIVE
SIMPLEX_VERBOSE=true
SIFTNG_OBSERVER_TYPE=EXTENSIVE
CONVICTION_OBSERVER_TYPE=EXTENSIVE

# ----- others ------
