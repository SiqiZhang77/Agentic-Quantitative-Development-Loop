# Non-sensitive Airflow Variable/local config.
JIRA_PROJECT_KEY=SCRUM
JIRA_CONNECTION_ID=jira_cloud
LITELLM_CONNECTION_ID=litellm_default
# Leave blank for pure backtesting runs that do not need GitHub writes.
GITHUB_CONNECTION_ID=
SANDBOX_IMAGE=ghcr.io/bankingscience/bslagenticquantdevloop/sandbox:stable
DOCKER_URL=
SANDBOX_EXECUTION_MODE=yarn
DOWNSTREAM_DAG_ID=quant_loop_mini
USE_REAL_BACKTESTER=true
BACKTEST_STORAGE_KIND=hdfs
SIMULATION_REQUESTS_DIR=hdfs:///quant-sandbox/simulation-requests
SIMULATION_RESULTS_DIR=hdfs:///quant-sandbox/simulation-results

# YARN mode only. Leave SANDBOX_EXECUTION_MODE=docker unless the Airflow worker
# can submit to YARN and access HDFS with these Hadoop settings.
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
SANDBOX_HDFS_NAMENODE_URI=hdfs://bialobog:8020
SANDBOX_HDFS_RUN_ROOT=/user/uarbi/quant-sandbox-runs
SANDBOX_YARN_QUEUE=root.uarbi
SANDBOX_YARN_MASTER_MEMORY_MB=512
SANDBOX_YARN_CONTAINER_MEMORY_MB=4096
SANDBOX_YARN_TIMEOUT_SECONDS=2100
SANDBOX_YARN_CLEANUP_HDFS=false

# Local development fallback only. Production should use Airflow Connections.
# Scoped Jira API tokens must use Atlassian's API gateway with the site Cloud ID.
JIRA_BASE_URL=https://api.atlassian.com/ex/jira/aa622dfc-3db1-414a-a4ab-20d8dbb3f3f4
JIRA_EMAIL=quant-loop-bot-m37ieah3yb@serviceaccount.atlassian.com
JIRA_API_TOKEN=replace-me-jira-service-account-token
GITHUB_USERNAME=replace-me-github-username
GITHUB_TOKEN=replace-me
LITELLM_API_KEY=replace-me-litellm-key
