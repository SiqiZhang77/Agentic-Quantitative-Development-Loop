{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankingscience.local/schemas/exp3/architect_plan_v1.schema.json",
  "title": "Experiment 3 Architect Plan Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "producer",
    "risks",
    "files",
    "acceptance_mapping"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "architect_plan_v1"
    },
    "producer": {
      "type": "string",
      "const": "architect"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "requirement",
          "planned_evidence",
          "files"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "planned_evidence": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
