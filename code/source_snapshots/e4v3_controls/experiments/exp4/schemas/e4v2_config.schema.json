{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankingscience.local/schemas/exp4-e4v2-prospective-config-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "freeze_status", "task_ids",
    "replicate_count", "conditions", "williams_order", "block_order_seed",
    "source", "control", "runtime", "task_bindings", "evaluator_bindings",
    "retrieval_binding", "shared_budget", "manager_star_role_budget", "execution"
  ],
  "properties": {
    "schema_version": {"enum": ["exp4-e4v2-prospective-config-v1", "exp4-e4v3-prospective-config-v1"]},
    "experiment_id": {"enum": ["E4V2", "E4V3"]},
    "freeze_status": {"enum": ["prospective_unready", "ready_for_freeze"]},
    "task_ids": {"const": ["T3"]},
    "replicate_count": {"enum": [5, 15]},
    "conditions": {
      "const": {
        "M0R0": {"architecture_mode": "single_agent", "rag_enabled": false, "retrieval_context_included": false, "role_topology": "single_agent"},
        "M0R1": {"architecture_mode": "single_agent", "rag_enabled": true, "retrieval_context_included": true, "role_topology": "single_agent"},
        "M1R0": {"architecture_mode": "manager_star", "rag_enabled": false, "retrieval_context_included": false, "role_topology": "manager_star"},
        "M1R1": {"architecture_mode": "manager_star", "rag_enabled": true, "retrieval_context_included": true, "role_topology": "manager_star"}
      }
    },
    "williams_order": {
      "type": "object", "minProperties": 5, "maxProperties": 15,
      "patternProperties": {"^[1-9][0-9]*$": {"$ref": "#/$defs/order"}},
      "additionalProperties": false
    },
    "block_order_seed": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "source_ref", "source_commit"],
      "properties": {
        "repository": {"const": "bankingscience/BSLAgenticQuantDevLoop"},
        "source_ref": {"$ref": "#/$defs/nonempty"},
        "source_commit": {"$ref": "#/$defs/commitOrPlaceholder"}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "control_ref", "control_commit", "control_files"],
      "properties": {
        "repository": {"const": "bankingscience/BSLAgenticQuantDevLoop"},
        "control_ref": {"$ref": "#/$defs/nonempty"},
        "control_commit": {"$ref": "#/$defs/commitOrPlaceholder"},
        "control_files": {"type": "array", "minItems": 10, "maxItems": 12, "items": {"$ref": "#/$defs/fileBinding"}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": [
        "image_ref", "image_digest", "formal_execution_contract", "rag_delivery_policy",
        "runtime_request_schema_sha256", "runtime_response_schema_sha256",
        "item_submission_schema_sha256", "tool_implementation_sha256",
        "model_visible_tool_fingerprint_sha256", "provider_identity_sha256",
        "provider_mode", "provider_base_url", "model_alias"
      ],
      "properties": {
        "image_ref": {"$ref": "#/$defs/nonempty"},
        "image_digest": {"$ref": "#/$defs/digestOrPlaceholder"},
        "formal_execution_contract": {"const": "factorial_rag_architecture_v1"},
        "rag_delivery_policy": {"const": "all_model_stages_v1"},
        "runtime_request_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "runtime_response_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "item_submission_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "tool_implementation_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "model_visible_tool_fingerprint_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "provider_identity_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "provider_mode": {"const": "openai"},
        "provider_base_url": {"const": "https://api.openai.com/v1"},
        "model_alias": {"const": "gpt-5.6-terra"}
      }
    },
    "task_bindings": {
      "type": "object", "additionalProperties": false, "required": ["T3"],
      "properties": {"T3": {"$ref": "#/$defs/t3TaskBinding"}}
    },
    "evaluator_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["T3", "private_base_scorer_sha256", "coordinator_sha256", "visible_response_trace_schema_sha256", "item_store_projection_sha256", "private_evaluator_manifest_sha256"],
      "properties": {
        "T3": {"$ref": "#/$defs/hashOrPlaceholder"},
        "private_base_scorer_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "coordinator_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "visible_response_trace_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "item_store_projection_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "private_evaluator_manifest_sha256": {"$ref": "#/$defs/hashOrPlaceholder"}
      }
    },
    "retrieval_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_query_context", "retriever_name", "retriever_version", "corpus_id",
        "corpus_sha256", "index_id", "index_sha256", "exclusion_list_id",
        "exclusion_list_sha256", "cutoff_at", "requested_top_k", "max_memories_per_source_ticket"
      ],
      "properties": {
        "task_query_context": {
          "type": "object", "additionalProperties": false, "required": ["T3"],
          "properties": {"T3": {"$ref": "#/$defs/queryContextBinding"}}
        },
        "retriever_name": {"$ref": "#/$defs/nonempty"},
        "retriever_version": {"$ref": "#/$defs/nonempty"},
        "corpus_id": {"$ref": "#/$defs/nonempty"},
        "corpus_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "index_id": {"$ref": "#/$defs/nonempty"},
        "index_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "exclusion_list_id": {"$ref": "#/$defs/nonempty"},
        "exclusion_list_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "cutoff_at": {"$ref": "#/$defs/nonempty"},
        "requested_top_k": {"const": 5},
        "max_memories_per_source_ticket": {"const": 2}
      }
    },
    "shared_budget": {
      "const": {
        "max_attempts": 2, "max_model_calls_per_attempt": 20,
        "max_tokens_per_attempt": 500000, "max_model_calls_per_observation": 40,
        "max_tokens_per_observation": 1000000, "attempt_timeout_seconds": 1800,
        "observation_timeout_seconds": 3600, "cpu_vcpus": 2,
        "memory_mb": 4096, "pids_limit": 256
      }
    },
    "manager_star_role_budget": {
      "const": {
        "manager": {"max_calls": 3, "max_tokens": 500000},
        "architect": {"max_calls": 3, "max_tokens": 500000},
        "developer": {"max_calls": 14, "max_tokens": 500000},
        "unused_capacity_transferable": true, "applies_per_attempt": true,
        "transfer_policy": {
          "source_role": "architect", "recipient_role": "developer",
          "release_after": "validated_architect_handoff",
          "manager_final_review_call_reserved": true
        }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "serial", "observations_per_authorization", "phase_order",
        "first_authorized_condition", "continue_after_observation_failure",
        "advance_only_after_block_audit", "agreement_generation_enabled", "formal_model_execution_enabled"
      ],
      "properties": {
        "serial": {"const": true},
        "observations_per_authorization": {"type": ["integer", "null"], "minimum": 1, "maximum": 60},
        "registered_observation_count": {"type": "integer", "minimum": 1, "maximum": 60},
        "selection_mode": {"enum": ["runtime_explicit_subset"]},
        "phase_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "first_authorized_condition": {"type": "string", "minLength": 1},
        "continue_after_observation_failure": {"const": true},
        "advance_only_after_block_audit": {"const": false},
        "agreement_generation_enabled": {"type": "boolean"},
        "formal_model_execution_enabled": {"const": false}
      }
    }
  },
  "$defs": {
    "placeholder": {"type": "string", "pattern": "^__UNRESOLVED_[A-Z0-9_]+__$"},
    "nonempty": {"type": "string", "minLength": 1},
    "hashOrPlaceholder": {"oneOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"$ref": "#/$defs/placeholder"}]},
    "commitOrPlaceholder": {"oneOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"$ref": "#/$defs/placeholder"}]},
    "digestOrPlaceholder": {"oneOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"$ref": "#/$defs/placeholder"}]},
    "integerOrPlaceholder": {"oneOf": [{"type": "integer", "minimum": 0}, {"$ref": "#/$defs/placeholder"}]},
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/hashOrPlaceholder"}}
    },
    "order": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["M0R0", "M0R1", "M1R0", "M1R1"]}
    },
    "queryContextBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["query_path", "query_sha256", "retrieval_context_path", "retrieval_context_sha256", "retrieval_context_byte_count", "memory_count"],
      "properties": {
        "query_path": {"$ref": "#/$defs/nonempty"},
        "query_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "retrieval_context_path": {"$ref": "#/$defs/nonempty"},
        "retrieval_context_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "retrieval_context_byte_count": {"$ref": "#/$defs/integerOrPlaceholder"},
        "memory_count": {"$ref": "#/$defs/integerOrPlaceholder"}
      }
    },
    "t3TaskBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "suite_version", "answer_capture_profile", "suite_root", "task_text_path", "task_text_sha256",
        "rubric_path", "rubric_sha256", "public_inputs", "item_submission_schema_path",
        "item_submission_schema_sha256", "output_schema_path", "output_schema_sha256", "result_contract"
      ],
      "properties": {
        "suite_version": {"const": "t3-quant-suite-v2"},
        "answer_capture_profile": {"const": "t3_item_results_v2"},
        "suite_root": {"const": "experiments/shared/t3-quant-suite-v2"},
        "task_text_path": {"const": "experiments/shared/t3-quant-suite-v2/TASK.md"},
        "task_text_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "rubric_path": {"const": "experiments/shared/t3-quant-suite-v2/RUBRIC.md"},
        "rubric_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "public_inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/fileBinding"}},
        "item_submission_schema_path": {"const": "experiments/shared/t3-quant-suite-v2/item_submission_schema_v2.json"},
        "item_submission_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "output_schema_path": {"const": "experiments/shared/t3-quant-suite-v2/output_schema_v1.json"},
        "output_schema_sha256": {"$ref": "#/$defs/hashOrPlaceholder"},
        "result_contract": {"type": "object"}
      }
    }
  }
}
